{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ExpenseTracker;Integrated Security=true;TrustServerCertificate=true"
  },
  "Database": { "ApplyMigrationsOnStartup": false },
  "Bills": {
    "MaxUploadBytes": 10485760,
    "AboveMarketTolerancePercent": 5,
    "TotalMismatchTolerance": 1,
    "ReminderDays": 3,
    "TimeZone": "Asia/Colombo"
  },
  "Claude": {
    "ApiKey": "",
    "UseCli": true,
    "CliTimeoutSeconds": 180,
    "Model": "claude-opus-5-5",
    "MaxTokens": 16000
  }
}
